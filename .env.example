# LLM runtime
# 所有 LLM 模块统一通过“全局设施面板”配置渠道、模型与模块绑定。
# 不再使用旧的单组 LLM 环境变量。
LLM_REQUEST_TIMEOUT_SECONDS=120

# Zep graph memory
ZEP_API_KEY=your_zep_api_key_here

# App runtime
APP_HOST=0.0.0.0
APP_PORT=3888
APP_DEBUG=true

# Narrative defaults
NARRATIVE_DEFAULT_BRANCH_COUNT=3
NARRATIVE_DEFAULT_TIMELINE_STEPS=12

# 深度阅读(sequential_reader) 无感自动重试策略
# 单段 LLM 调用级别的段级重试次数(含首次尝试)。
SEED_SEGMENT_RETRY_MAX_ATTEMPTS=2
SEED_SEGMENT_RETRY_INITIAL_DELAY_SECONDS=10
SEED_SEGMENT_RETRY_MAX_DELAY_SECONDS=30
# 连续 N 段失败后注入 stage 级冷却,缓解上游限流风暴。
SEED_STAGE_COOLDOWN_STREAK=3
SEED_STAGE_COOLDOWN_SECONDS=30
# 段落循环结束后,是否对仍标记为 retry_needed 的段落做最保守的扫尾重试。
SEED_SWEEP_ENABLED=true
# 后端重启后，自动对被杀的种子任务触发一次 create_retry_task（补齐段落 +
# 弧/卷摘要 + 重跑下游聚合与图谱）。仅对已生成 smart_segments.json 的项目
# 生效。默认关闭 —— 打开后用户无需手动点"一键重读"。
SEED_AUTO_RESUME_ON_STARTUP=false

# Phase E — 防止 LLM 返回数据被隐式截断丢失
# evidence/quote 列表上限：避免 UI 崩同时保留更多原文佐证（默认 10，原值 3）。
SEED_MAX_EVIDENCE_PER_ITEM=10
# chapter_beats 上限：长篇可调高便于看完整时间线（默认 50，原值 20）。
SEED_MAX_CHAPTER_BEATS=50
# 段落上下文滚动窗口：assemble_context() 注入最近 N 段摘要（默认 5，原值 2）。
SEED_RECENT_SUMMARIES_WINDOW=5
# Story ontology 输入分块大小（字节）：超过此长度走 chunk-merge，避免硬截 60KB（默认 50KB）。
SEED_ONTOLOGY_CHUNK_SIZE=51200
# 角色档案生成时引用的最近 N 个弧线/卷摘要（默认 10/5，原值 5/3）。
SEED_CHARACTER_PROFILE_ARC_WINDOW=10
SEED_CHARACTER_PROFILE_VOLUME_WINDOW=5

# 图谱管线放宽参数 —— 原值把配角 / 事件 / 道具 的大量数据截断成稀疏图，这里调宽默认
# 角色 tier 门槛：提及 >= protagonist 阈值 → protagonist；>= major 阈值 → major（原值 4 / 2）
SEED_MENTION_MIN_PROTAGONIST=3
SEED_MENTION_MIN_MAJOR=1
# 组织 tier 门槛（原值 2）
SEED_ORG_MENTION_MIN_MAJOR=1
# 角色 profile 生成门槛：提及 >= 此值才生成 agent profile（原值 2）
SEED_PROFILE_IMPORTANCE_THRESHOLD=1
# 图谱边构造器的切片上限，防止爆炸同时保留更多关系
GRAPH_ARTIFACT_EDGE_PAIR_LIMIT=8
GRAPH_EVENT_EVIDENCE_LIMIT=5
GRAPH_ARTIFACT_CANDIDATE_LIMIT=8
GRAPH_EVENT_CANDIDATE_EVIDENCE_LIMIT=5
