# LLM runtime
# 所有 LLM 模块统一通过“全局设施面板”配置渠道、模型与模块绑定。
# 不再使用旧的单组 LLM 环境变量。
LLM_REQUEST_TIMEOUT_SECONDS=120

# Zep graph memory
ZEP_API_KEY=your_zep_api_key_here

# App runtime
APP_HOST=0.0.0.0
APP_PORT=3888
APP_DEBUG=true

# Narrative defaults
NARRATIVE_DEFAULT_BRANCH_COUNT=3
NARRATIVE_DEFAULT_TIMELINE_STEPS=12
