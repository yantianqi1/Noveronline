# Legacy backend reference configuration. The active SaaS stack uses
# ../infra/.env.example instead.

# LLM modules are configured through the SaaS LLM Facility. Legacy single
# provider environment variables are intentionally unsupported.
LLM_REQUEST_TIMEOUT_SECONDS=120

# Optional legacy graph memory integration.
ZEP_API_KEY=

APP_HOST=127.0.0.1
APP_PORT=3888
APP_DEBUG=true

NARRATIVE_DEFAULT_BRANCH_COUNT=3
NARRATIVE_DEFAULT_TIMELINE_STEPS=12

SEED_SEGMENT_RETRY_MAX_ATTEMPTS=2
SEED_SEGMENT_RETRY_INITIAL_DELAY_SECONDS=10
SEED_SEGMENT_RETRY_MAX_DELAY_SECONDS=30
SEED_STAGE_COOLDOWN_STREAK=3
SEED_STAGE_COOLDOWN_SECONDS=30
SEED_SWEEP_ENABLED=true
SEED_AUTO_RESUME_ON_STARTUP=false

SEED_MAX_EVIDENCE_PER_ITEM=10
SEED_MAX_CHAPTER_BEATS=50
SEED_RECENT_SUMMARIES_WINDOW=5
SEED_ONTOLOGY_CHUNK_SIZE=51200
SEED_CHARACTER_PROFILE_ARC_WINDOW=10
SEED_CHARACTER_PROFILE_VOLUME_WINDOW=5

SEED_MENTION_MIN_PROTAGONIST=3
SEED_MENTION_MIN_MAJOR=1
SEED_ORG_MENTION_MIN_MAJOR=1
SEED_PROFILE_IMPORTANCE_THRESHOLD=1
GRAPH_ARTIFACT_EDGE_PAIR_LIMIT=8
GRAPH_EVENT_EVIDENCE_LIMIT=5
GRAPH_ARTIFACT_CANDIDATE_LIMIT=8
GRAPH_EVENT_CANDIDATE_EVIDENCE_LIMIT=5
