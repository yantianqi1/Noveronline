{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirofish.local/contracts/writer-runtime-event.schema.json",
  "title": "Writer runtime workflow event",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "project_id", "run_id", "workflow_type", "event_type", "payload"],
  "properties": {
    "tenant_id": { "$ref": "#/$defs/nonEmptyString" },
    "project_id": { "$ref": "#/$defs/nonEmptyString" },
    "run_id": { "$ref": "#/$defs/nonEmptyString" },
    "workflow_type": { "const": "writer_run" },
    "event_type": {
      "enum": [
        "writer.run.started",
        "writer.token",
        "writer.tool.started",
        "writer.tool.completed",
        "writer.draft.saved",
        "writer.retrieval_plan.completed",
        "writer.retrieval_plan.degraded",
        "writer.retrieval_plan.skipped",
        "writer.context_budget.trimmed",
        "writer.consistency.violations",
        "writer.consistency.clean",
        "writer.consistency.skipped",
        "writer.consistency.degraded",
        "writer.revision.proposed",
        "writer.approval.required",
        "writer.approval.resolved",
        "writer.run.failed",
        "writer.run.completed",
        "writer.run.cancelled"
      ]
    },
    "payload": { "type": "object" },
    "idempotency_key": { "$ref": "#/$defs/nonEmptyString" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
