# Copy values from a secret manager. The validation script rejects these placeholders.
MIROFISH_DEPLOYMENT_ENV=production
COMPOSE_PROJECT_NAME=mirofish-production
POSTGRES_DB=mirofish
POSTGRES_USER=replace-with-admin-user
POSTGRES_PASSWORD=replace-with-secret
APP_DATABASE_USER=mirofish_runtime
APP_DATABASE_PASSWORD=replace-with-secret
DATABASE_URL=postgresql://replace-with-runtime-dsn
MIROFISH_AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
MIROFISH_RECOVERY_CLIENT_PROOF_SECRET=replace-with-at-least-32-random-characters
MIROFISH_TRUSTED_CLIENT_IP_HEADER=X-Real-IP
AUTH_RECOVERY_OUTBOX_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
LLM_CREDENTIAL_ENCRYPTION_KEY=replace-with-valid-production-key
MINIO_ROOT_USER=replace-with-storage-user
MINIO_ROOT_PASSWORD=replace-with-secret
MIROFISH_OBJECT_STORAGE_BUCKET=mirofish-production-uploads
MIROFISH_OBJECT_STORAGE_ENDPOINT=minio:9000
MIROFISH_OBJECT_STORAGE_ACCESS_KEY=replace-with-storage-access-key
MIROFISH_OBJECT_STORAGE_SECRET_KEY=replace-with-storage-secret-key
MIROFISH_OBJECT_STORAGE_USE_SSL=false
MIROFISH_OBJECT_STORAGE_REGION=us-east-1
TEMPORAL_NAMESPACE=mirofish-production
MIROFISH_AUTH_RATE_LIMIT_REDIS_URL=redis://redis:6379/0
MIROFISH_RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-random-characters
MIROFISH_RATE_LIMIT_POLICIES_JSON={"auth_login":{"limit":10,"window_seconds":60},"auth_signup":{"limit":5,"window_seconds":300},"auth_session_mutation":{"limit":20,"window_seconds":60},"collaboration_invite_create":{"limit":10,"window_seconds":60},"collaboration_invite_accept":{"limit":20,"window_seconds":60},"llm_admin_mutation":{"limit":20,"window_seconds":60},"llm_provider_health":{"limit":30,"window_seconds":60}}
SMTP_HOST=smtp.example.invalid
SMTP_PORT=465
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-secret
SMTP_FROM=no-reply@example.invalid
SMTP_TLS_MODE=implicit_tls
AUTH_RECOVERY_RESET_BASE_URL=https://app.example.invalid/recovery/reset
COLLABORATION_ACCEPT_BASE_URL=https://app.example.invalid/invitations/accept
API_PORT=3888
WEB_PORT=3999
