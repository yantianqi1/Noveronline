COMPOSE_PROJECT_NAME=mirofish-saas

POSTGRES_DB=mirofish
POSTGRES_USER=mirofish
POSTGRES_PASSWORD=mirofish_dev_password
POSTGRES_PORT=54329

REDIS_PORT=63799

TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=mirofish
MINIO_ROOT_PASSWORD=mirofish_dev_password

# Go API verifies source upload completion with these settings.
# Python seed workers also use them to read source objects and write extracted text artifacts.
# Use the host endpoint for local API runs; containerized workers use minio:9000 from compose.
MIROFISH_OBJECT_STORAGE_ENDPOINT=127.0.0.1:9000
MIROFISH_OBJECT_STORAGE_BUCKET=mirofish-uploads
MIROFISH_OBJECT_STORAGE_ACCESS_KEY=mirofish
MIROFISH_OBJECT_STORAGE_SECRET_KEY=mirofish_dev_password
MIROFISH_OBJECT_STORAGE_USE_SSL=false

PI_AGENT_RUNTIME_NODE_VERSION=22.19.0

# 32-byte AES key for decrypting LLM Facility channel credentials.
# Leave empty for local fail-closed Pi writer runtime until a real dev key is generated.
LLM_CREDENTIAL_ENCRYPTION_KEY=
